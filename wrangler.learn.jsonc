{
  "name": "shieldio-learn",
  "main": "learn/worker.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "learn.shieldio.cz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
