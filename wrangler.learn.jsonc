{
  "name": "shieldio-learn",
  "main": "learn/worker.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "vars": { "EDUPAGE_LOCAL_ENABLED": "false", "PUBLIC_HOST": "learn.shieldio.cz" },
  "durable_objects": { "bindings": [{ "name": "NOTE_SUBMISSIONS", "class_name": "NoteSubmissionGuard" }] },
  "migrations": [{ "tag": "notes-v1", "new_sqlite_classes": ["NoteSubmissionGuard"] }],
  "routes": [
    {
      "pattern": "learn.shieldio.cz",
      "custom_domain": true
    }
  ],
  "ratelimits": [{ "name": "EDUPAGE_RATE_LIMITER", "namespace_id": "26090802", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
