{
  "name": "shieldio-simulation",
  "main": "workers/simulation.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [{ "pattern": "simulation.shieldio.cz", "custom_domain": true }],
  "assets": {
    "directory": "experiments/simulation",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
